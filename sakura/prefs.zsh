# ✿ sakura switches (1 = on, 0 = off). Easiest to change with the `settings` command.
SAKURA_GREET=1
SAKURA_BOOT=1
SAKURA_KEYS=1
SAKURA_TIP=1
SAKURA_SHELL_LOG=0      # 1 = remember your terminal commands for 3 days so `hub` and the flower can see them
# SAKURA_NAME=Sam       # name in the greeting (default: your macOS first name, empty = no name)
